# -----------------------------------------------------------------------------
# Laundry Management System — environment configuration template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust:
#     cp .env.example .env
# The real `.env` is git-ignored so credentials never reach the repository.
# -----------------------------------------------------------------------------

# Engine: "sqlite" (zero setup, default) or "mysql"
DB_ENGINE=sqlite

# --- SQLite (only used when DB_ENGINE=sqlite) ---
DB_PATH=laundry.db

# --- MySQL (only used when DB_ENGINE=mysql) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=laundry_db
