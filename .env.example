# -----------------------------------------------------------------------------
# Laundry Management System — environment configuration template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# The real `.env` is git-ignored so your password never reaches the repository.
# -----------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=laundry_db
